---
import MediaSlot from "../MediaSlot.astro";
import { products } from "../../content/site";
import { isExternal } from "../../lib/links";

const refill = products.smartRefill;
const laundry = products.laundry;
const carwash = products.carwash;
const gym = products.gym;
const mobile = products.mobile;
---

<section id="products">
  <div class="wrap">
    <div class="sec-head reveal">
      <div>
        <span class="label">{products.label}</span>
        <h2>{products.titleLead}<br /><span class="grad">{products.titleAccent}</span></h2>
      </div>
      <p class="lead">{products.lead}</p>
    </div>
    <div class="prod-grid">
      <a href={refill.href} class="glass hov prod p-main reveal" rel={isExternal(refill.href) ? "noreferrer" : undefined}>
        <MediaSlot label={refill.screenshotLabel} src={refill.screenshotSrc} alt={refill.screenshotAlt} boxClass="shot" />
        <div class="body">
          <div class="top"><h3>{refill.name}</h3><span class="status live">{refill.status}</span></div>
          <span class="dom">{refill.domain}</span>
          <p>{refill.body}</p>
          <div class="chips">
            {refill.chips.map((chip) => <span>{chip}</span>)}
            {refill.aiChips.map((chip) => <span class="ai">{chip}</span>)}
          </div>
          <span class="go">{refill.cta} <span class="arrow">→</span></span>
        </div>
      </a>
      <a href={laundry.href} class="glass hov prod p-sm reveal" rel={isExternal(laundry.href) ? "noreferrer" : undefined}>
        <div class="body">
          <div class="top"><h3>{laundry.name}</h3><span class="status soon">{laundry.status}</span></div>
          <span class="dom">{laundry.domain}</span>
          <p>{laundry.body}</p>
          <div class="chips">
            {laundry.chips.map((chip) => <span>{chip}</span>)}
            {laundry.aiChips.map((chip) => <span class="ai">{chip}</span>)}
          </div>
          <span class="bigico">{laundry.icon}</span>
          <span class="go">{laundry.cta} <span class="arrow">→</span></span>
        </div>
      </a>
      <a href={carwash.href} class="glass hov prod p-sm reveal" rel={isExternal(carwash.href) ? "noreferrer" : undefined}>
        <div class="body">
          <div class="top"><h3>{carwash.name}</h3><span class="status soon">{carwash.status}</span></div>
          <span class="dom">{carwash.domain}</span>
          <p>{carwash.body}</p>
          <div class="chips">
            {carwash.chips.map((chip) => <span>{chip}</span>)}
            {carwash.aiChips.map((chip) => <span class="ai">{chip}</span>)}
          </div>
          <span class="bigico">{carwash.icon}</span>
          <span class="go">{carwash.cta} <span class="arrow">→</span></span>
        </div>
      </a>
      <a href={gym.href} class="glass hov prod p-sm reveal" rel={isExternal(gym.href) ? "noreferrer" : undefined}>
        <div class="body">
          <div class="top"><h3>{gym.name}</h3><span class="status soon">{gym.status}</span></div>
          <span class="dom">{gym.domain}</span>
          <p>{gym.body}</p>
          <div class="chips">
            {gym.chips.map((chip) => <span>{chip}</span>)}
            {gym.aiChips.map((chip) => <span class="ai">{chip}</span>)}
          </div>
          <span class="bigico">{gym.icon}</span>
          <span class="go">{gym.cta} <span class="arrow">→</span></span>
        </div>
      </a>
      <a href={mobile.href} class="glass hov prod p-wide reveal">
        <div class="body">
          <div class="top"><h3>{mobile.name}</h3><span class="status soon">{mobile.status}</span></div>
          <span class="dom">{mobile.domain}</span>
          <p>{mobile.body}</p>
          <span class="go">{mobile.cta} <span class="arrow">→</span></span>
        </div>
      </a>
    </div>
  </div>
</section>
