---
import { company, footer, seo } from "../content/site";
import { isExternal, samePageHref } from "../lib/links";
import { isPlaceholder } from "../lib/placeholders";

const path = Astro.url.pathname.replace(/\/$/, "") || "/";
const legalLinks = footer.legalLinks ?? [
  { label: company.privacy.label, href: company.privacy.href },
  { label: company.terms.label, href: company.terms.href },
  { label: "Journey", href: "/journey" },
];
---

<footer>
  <div class="wrap">
    <div class="f-grid">
      <div>
        <a href="/" class="logo" aria-label="River home">
          <img src={seo.logoMark} alt={seo.logoMarkAlt} width="150" height="40" />
        </a>
        <p style="margin-top:16px;max-width:320px">{footer.blurb}</p>
        <p class="f-motto grad">{company.motto}</p>
      </div>
      {
        footer.columns.map((column) => (
          <div>
            <h4>{column.title}</h4>
            <ul>
              {column.links.map((link) => (
                <li>
                  <a href={samePageHref(link.href, path)} rel={isExternal(link.href) ? "noreferrer" : undefined}>
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
      <div>
        <h4>{footer.companyTitle}</h4>
        <ul>
          {
            legalLinks.map((link) =>
              link.href ? (
                <li>
                  <a href={samePageHref(link.href, path)}>{link.label}</a>
                </li>
              ) : null
            )
          }
          <li>
            {
              isPlaceholder(company.contactEmail) ? (
                <span class="ph">{company.contactEmail}</span>
              ) : (
                <a href={`mailto:${company.contactEmail}`}>{company.contactEmail}</a>
              )
            }
          </li>
          <li>
            {
              isPlaceholder(company.officeAddress) ? (
                <span class="ph">{company.officeAddress}</span>
              ) : (
                <span>{company.officeAddress}</span>
              )
            }
          </li>
          {
            company.socialProfiles.length > 0
              ? company.socialProfiles.map((profile) => (
                  <li>
                    <a href={profile.href} rel="noreferrer">
                      {profile.label}
                    </a>
                  </li>
                ))
              : company.socialLinksLabel && isPlaceholder(company.socialLinksLabel)
                ? (
                    <li>
                      <span class="ph">{company.socialLinksLabel}</span>
                    </li>
                  )
                : null
          }
        </ul>
      </div>
    </div>
    <div class="f-bottom">
      <span>
        © {company.copyrightYear} {company.legalName} · {
          company.privacy.href ? (
            <a href={company.privacy.href}>{isPlaceholder(company.privacy.label) ? "Privacy Policy" : company.privacy.label}</a>
          ) : isPlaceholder(company.privacy.label) ? (
            <span class="ph">{company.privacy.label}</span>
          ) : (
            company.privacy.label
          )
        } · {
          company.terms.href ? (
            <a href={company.terms.href}>{isPlaceholder(company.terms.label) ? "Terms of Use" : company.terms.label}</a>
          ) : isPlaceholder(company.terms.label) ? (
            <span class="ph">{company.terms.label}</span>
          ) : (
            company.terms.label
          )
        }
      </span>
      <span>{company.footerNote}</span>
    </div>
  </div>
</footer>
