---
import { nav, seo } from "../content/site";
import { samePageHref } from "../lib/links";

const path = Astro.url.pathname.replace(/\/$/, "") || "/";
---

<div class="topbar"></div>
<header class="nav">
  <div class="wrap">
    <a href="/" class="logo" aria-label="River home">
      <img src={seo.logoMark} alt={seo.logoMarkAlt} width="150" height="40" />
    </a>
    <nav class="nav-links" aria-label="Primary">
      {
        nav.items.map((item) => (
          <a
            href={samePageHref(item.href, path)}
            class:list={["badge" in item && item.badge ? "nav-brand" : undefined]}
            aria-label={"badge" in item && item.badge ? `${item.label} ${item.badge}` : undefined}
          >
            {item.label}
            {"badge" in item && item.badge ? <span class="nav-badge">{item.badge}</span> : null}
          </a>
        ))
      }
    </nav>
    <div class="nav-cta">
      <a href={samePageHref("/#partner", path)} class="btn btn-primary btn-sm">{nav.partner}</a>
      <button class="menu-btn" type="button" aria-label={nav.menuLabel} aria-expanded="false" aria-controls="mobile-nav">
        <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M4 8h16M4 16h16" stroke="#fff" stroke-width="2" stroke-linecap="round"></path>
        </svg>
      </button>
    </div>
  </div>
  <div class="mobile-nav" id="mobile-nav">
    {
      nav.items.map((item) => (
        <a
          href={samePageHref(item.href, path)}
          class:list={["badge" in item && item.badge ? "nav-brand" : undefined]}
          aria-label={"badge" in item && item.badge ? `${item.label} ${item.badge}` : undefined}
        >
          {item.label}
          {"badge" in item && item.badge ? <span class="nav-badge">{item.badge}</span> : null}
        </a>
      ))
    }
    <a href={samePageHref("/#partner", path)}>{nav.partner}</a>
  </div>
</header>
