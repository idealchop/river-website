---
import { imageAlt } from "../lib/placeholders";

interface Props {
  label: string;
  src?: string;
  alt?: string;
  boxClass?: string;
}

const { label, src = "", alt = "", boxClass = "" } = Astro.props;
---

{
  src ? (
    <img class:list={["media-fill", boxClass]} src={src} alt={imageAlt(label, alt)} />
  ) : (
    <div class:list={["ph-box", boxClass]}>{label}</div>
  )
}
